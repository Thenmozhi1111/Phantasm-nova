# ---- Server ----
PORT=4000
NODE_ENV=development
# Comma-separated list of allowed origins for CORS (your frontend URL(s))
CORS_ORIGIN=http://localhost:5173

# ---- PostgreSQL ----
# Either set DATABASE_URL, or the individual PG* vars below.
DATABASE_URL=postgresql://postgres:Phantasm@2722nova@db.akxbydhmbubtxsbgylbs.supabase.co:5432/postgres
PGSSL=false

# ---- Sessions (admin login) ----
# Long random string used to sign the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=change-this-to-a-long-random-string

# ---- Auth tokens (user login/register) ----
# Used to sign the JWT issued on user register/login. Without this,
# register/login requests fail. Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=6f3a9c1e8b4d7f2a5c9e1b3d6f8a2c4e7b1d3f5a8c2e4b6d9f1a3c5e7b9d1f3a
JWT_EXPIRES_IN=7d

# ---- Initial admin account (used only by `npm run seed:admin`) ----
ADMIN_EMAIL=phantasm2722@gmail.com
ADMIN_PASSWORD=jruqqpgkztczasts

# ---- Outgoing email (SMTP) ----
# Works with Gmail (use an App Password), SendGrid, Mailgun, Resend SMTP, etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=phantasm2722@gmail.com
SMTP_PASS=jruqqpgkztczasts
SMTP_FROM=Phantasm26 <no-reply@gmail.com>
# If SMTP_HOST/SMTP_USER/SMTP_PASS are left blank, the server logs emails to
# the console instead of sending them, so the app still runs without a
# mail account configured.

# Public URL of the deployed frontend, used to build links inside emails
# (password reset link, etc).
FRONTEND_URL=http://localhost:5173

# ---- Payments (Cashfree) ----
# Leave blank to run in mock-payment mode: registrations are auto-marked
# PAID immediately, useful for local development / demos without a
# Cashfree merchant account.
CASHFREE_APP_ID=TEST111826786eeaf0e1015497a8b47c87628111
CASHFREE_SECRET_KEY=cfsk_ma_test_583eac91c7c1de44c034ba9fae0bc151_78214370
# sandbox | production
CASHFREE_ENV=sandbox
