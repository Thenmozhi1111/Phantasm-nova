# Base URL of the backend API (no trailing slash, no /api suffix —
# src/lib/api.js already prefixes each call with /api/...).
# Must match the PORT the backend is actually running on (see backend/.env).
VITE_API_URL=http://localhost:4000

# Must match backend's CASHFREE_ENV (sandbox | production). Controls which
# mode the Cashfree Checkout JS SDK loads in on the frontend.
VITE_CASHFREE_ENV=sandbox
